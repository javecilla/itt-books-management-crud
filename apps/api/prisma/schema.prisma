generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  TEACHER
  STUDENT
}

model User {
  id        Int      @id @default(autoincrement())
  username  String   @unique
  password  String
  role      Role
  createdAt DateTime @default(now())

  books      Book[]       @relation("TeacherBooks")
  assigned   Assignment[] @relation("StudentAssignments")
  assignedBy Assignment[] @relation("TeacherAssignments")
}

model Book {
  id          Int      @id @default(autoincrement())
  title       String
  description String
  coverImage  String
  teacherId   Int
  teacher     User     @relation("TeacherBooks", fields: [teacherId], references: [id])
  createdAt   DateTime @default(now())

  assignments Assignment[]
}

model Assignment {
  id           Int      @id @default(autoincrement())
  bookId       Int
  studentId    Int
  assignedById Int
  assignedAt   DateTime @default(now())

  book       Book @relation(fields: [bookId], references: [id])
  student    User @relation("StudentAssignments", fields: [studentId], references: [id])
  assignedBy User @relation("TeacherAssignments", fields: [assignedById], references: [id])

  @@unique([bookId, studentId])
}
